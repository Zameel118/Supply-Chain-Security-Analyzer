# Copy this file to .env and fill in values before running docker compose.
# SECRET_KEY and TOKEN_ENCRYPTION_KEY are required — the API will not start without them.
# Never reuse local .env values in production (Render / Vercel).

# Postgres
POSTGRES_USER=scsa
POSTGRES_PASSWORD=scsa_dev_password
POSTGRES_DB=supply_chain_analyzer

# Backend
DATABASE_URL=postgresql+psycopg://scsa:scsa_dev_password@postgres:5432/supply_chain_analyzer
REDIS_URL=redis://redis:6379/0

# Required secrets (generate before first run — do NOT leave placeholders)
#   SECRET_KEY: any long random string
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   TOKEN_ENCRYPTION_KEY: Fernet key (32 random bytes, url-safe base64)
#     python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
FRONTEND_URL=http://localhost:3000

# Periodic re-scans (Celery beat). Keep false locally unless you start a beat process.
PERIODIC_RESCAN_ENABLED=false
PERIODIC_RESCAN_INTERVAL_HOURS=24
PERIODIC_RESCAN_MIN_AGE_HOURS=20

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
